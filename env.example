# Copy this file to .env and add your own Gemini API key.
# Do not put real keys in public/app.js or upload them to GitHub.
GEMINI_API_KEY=put_your_key_here
# Replace the placeholder locally; never commit .env to GitHub.
# Optional: choose a vision-capable Gemini model available to your API account.
GEMINI_MODEL=gemini-2.5-flash
PORT=3000
